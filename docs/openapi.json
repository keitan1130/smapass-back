                "type": "null"
              }
            ]
          },
          "number": {
            "examples": [
              "01ABCDEFGH"
            ],
            "pattern": "^[0-9A-HJKMNP-TV-Z]{10}$",
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "status": {
            "enum": [
              "valid",
              "revoked",
              "superseded"
            ],
