                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "initial_full_charge_mah": {
            "anyOf": [
              {
                "format": "int32",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest_full_charge_mah": {
            "anyOf": [
              {
                "format": "int32",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "trend": {
            "items": {
              "$ref": "#/components/schemas/BatteryPoint"
            },
            "type": "array"
          }
        },
        "required": [
          "latest_full_charge_mah",
          "initial_full_charge_mah",
          "change_percent",
          "cycle_count",
          "trend"
        ],
        "type": "object"
      },
      "BatteryPoint": {
        "properties": {
          "collected_at": {
            "format": "date-time",
            "type": "string"
          },
