            "anyOf": [
              {
                "format": "int32",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "temperature_c": {
            "anyOf": [
              {
                "format": "double",
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "collected_at",
          "full_charge_mah",
          "temperature_c"
        ],
        "type": "object"
      },
      "Certificate": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "imei": {
            "pattern": "^[0-9]{15}$",
            "type": "string"
          },
          "is_demo": {
            "type": "boolean"
          },
