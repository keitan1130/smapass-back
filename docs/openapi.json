  "info": {
    "description": "IMEI-managed device registration and certificate reads. JWT token issuance, signed log ingestion, grading, certificate issuance and chain anchoring are not implemented.",
    "title": "smapass-back API",
    "version": "0.1.0"
  },
  "openapi": "3.2.1",
  "paths": {
    "/api/certificates": {
      "get": {
        "operationId": "listCertificates",
        "parameters": [
          {
            "description": "Certificate UUID or legacy 10-character certificate number; comma-separated for ids (up to 50).",
            "example": "01ABC-DEFGH",
            "in": "query",
            "name": "ids",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificates"
                }
              }
            },
            "description": "Public certificates"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid input"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Method not allowed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limited"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unavailable"
          }
        },
        "summary": "Read certificates by known public numbers"
      }
    },
    "/api/certificates/{number}": {
      "get": {
        "operationId": "getCertificate",
        "parameters": [
          {
            "description": "Certificate UUID or legacy 10-character certificate number; comma-separated for ids (up to 50).",
            "in": "path",
            "name": "number",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificate"
                }
              }
            },
            "description": "Public certificate"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid input"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Method not allowed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limited"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unavailable"
          }
        },
        "summary": "Read an issued public snapshot and current listing"
      }
    },
    "/api/certificates/{number}/records": {
      "get": {
        "operationId": "getCertificateRecords",
        "parameters": [
          {
            "description": "Certificate UUID or legacy 10-character certificate number; comma-separated for ids (up to 50).",
            "in": "path",
            "name": "number",
            "required": true,
