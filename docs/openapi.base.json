  "x-schema-overrides": {
    "Certificate": {
      "number": {
        "pattern": "^[0-9A-HJKMNP-TV-Z]{10}$",
        "examples": [
          "01ABCDEFGH"
        ]
      },
      "status": {
        "enum": [
          "valid",
          "revoked",
          "superseded"
        ]
      },
      "id": {
        "format": "uuid"
      },
      "imei": {
        "pattern": "^[0-9]{15}$"
      }
    },
    "VerificationRecord": {
      "anchor_state": {
        "enum": [
          "unanchored",
          "pending",
          "confirmed",
          "failed"
        ]
      },
      "type": {
        "enum": [
          "spec",
          "status",
          "inspection"
        ]
      },
      "payload_hash": {
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "ProofStep": {
      "side": {
        "enum": [
          "left",
          "right"
        ]
      },
      "hash": {
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "Listing": {
      "imei_suffix": {
        "pattern": "^[0-9]{4}$"
      }
    },
    "Health": {
      "status": {
        "const": "ok"
      }
    },
