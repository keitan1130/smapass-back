{
  "openapi": "3.2.1",
  "info": {
    "title": "smapass-back API",
    "version": "0.1.0",
    "description": "IMEI-managed devices with Android hardware key attestation, proof of possession and anonymous app credentials. Signed log ingestion, grading, certificate issuance and chain anchoring are not implemented."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Process liveness",
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "summary": "Database readiness",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/certificates": {
      "get": {
        "operationId": "listCertificates",
        "summary": "Read the latest issued snapshot by IMEI, including released registrations and revoked snapshots",
        "parameters": [
          {
            "name": "imeis",
            "in": "query",
            "required": true,
            "description": "Comma-separated IMEIs (1 to 50); duplicates and aliases resolve to one latest issued snapshot per device, ordered by primary IMEI.",
            "schema": {
              "type": "string"
            },
            "example": "000000000094821,490154203237518"
          }
        ],
        "responses": {
          "200": {
            "description": "Public certificates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificates"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Public references use primary or secondary IMEI only. Lifetime device history remains readable after registration release, transfer, or certificate revocation. Certificate UUIDs and short numbers are not accepted or returned. No issued snapshot returns 404; GET /api/devices/{imei} remains available for a known device even without issuance. An old seller listing is omitted after registration release."
      }
    },
    "/api/certificates/{imei}": {
      "get": {
        "operationId": "getCertificate",
        "summary": "Read the latest issued snapshot by IMEI, including released registrations and revoked snapshots",
        "parameters": [
          {
            "name": "imei",
            "in": "path",
            "required": true,
            "description": "15-digit IMEI with a valid check digit; primary and secondary IMEIs are accepted.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{15}$"
            },
            "example": "000000000094821"
          }
        ],
        "responses": {
          "200": {
            "description": "Public certificate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificate"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Public references use primary or secondary IMEI only. Lifetime device history remains readable after registration release, transfer, or certificate revocation. Certificate UUIDs and short numbers are not accepted or returned. No issued snapshot returns 404; GET /api/devices/{imei} remains available for a known device even without issuance. An old seller listing is omitted after registration release."
      }
    },
    "/api/certificates/{imei}/records": {
      "get": {
        "operationId": "getCertificateRecords",
        "summary": "Read cumulative published evidence across all registration periods by IMEI",
        "parameters": [
          {
            "name": "imei",
            "in": "path",
            "required": true,
            "description": "15-digit IMEI with a valid check digit; primary and secondary IMEIs are accepted.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{15}$"
            },
            "example": "000000000094821"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 1000000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence page; these records do not imply verification success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Records"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Public references use primary or secondary IMEI only. Lifetime device history remains readable after registration release, transfer, or certificate revocation. Certificate UUIDs and short numbers are not accepted or returned. Includes the deduplicated union of logs previously included in issued snapshots. Known devices without published evidence return an empty page."
      }
    },
    "/certificates/{imei}": {
      "get": {
        "operationId": "getCurrentCertificateByIMEI",
        "summary": "Read the latest issued snapshot by IMEI, including released registrations and revoked snapshots",
        "parameters": [
          {
            "name": "imei",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{15}$"
            },
            "description": "15-digit IMEI with a valid check digit; primary and secondary IMEIs are accepted.",
            "example": "000000000094821"
          }
        ],
        "responses": {
          "200": {
            "description": "Current certificate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificate"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Public references use primary or secondary IMEI only. Lifetime device history remains readable after registration release, transfer, or certificate revocation. Certificate UUIDs and short numbers are not accepted or returned. No issued snapshot returns 404; GET /api/devices/{imei} remains available for a known device even without issuance. An old seller listing is omitted after registration release."
      }
    },
    "/api/devices": {
      "post": {
        "operationId": "registerDevice",
        "summary": "Rotate an attested P-256 key with a fresh server challenge",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDevice"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Owned device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Invalid, expired, reused or mismatched challenge; active IMEI or conflicting key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Attestation policy unconfigured or revocation status unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Attestation or proof of possession rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/lookup": {
      "post": {
        "operationId": "lookupOwnedDevice",
        "summary": "Look up an owned device by IMEI",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "imei"
                ],
                "additionalProperties": false,
                "properties": {
                  "imei": {
                    "type": "string",
                    "pattern": "^[0-9]{15}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Owned device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Device in use or identifier conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{imei}/revoke": {
      "post": {
        "operationId": "revokeOwnedDevice",
        "summary": "Release current device registration and revoke credentials and keys; preserve public lifetime state and issued snapshots",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "imei",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{15}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Registration ended; active keys and valid certificates revoked; immediately available for registration"
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "During sale or transfer, old credentials and keys lose writing authority while lifetime device state and history remain publicly readable by IMEI. The next holder can immediately register the same device and continue its sequence and previous hash."
      }
    },
    "/api/auth/devices": {
      "post": {
        "operationId": "enrollAppInstallation",
        "summary": "Atomically register an attested P-256 key and issue anonymous app credentials",
        "responses": {
