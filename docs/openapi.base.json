          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/certificates": {
      "get": {
        "operationId": "listCertificates",
        "summary": "Read certificates by known public numbers",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "description": "Certificate UUID or legacy 10-character certificate number; comma-separated for ids (up to 50).",
            "schema": {
              "type": "string"
            },
            "example": "01ABC-DEFGH"
          }
        ],
        "responses": {
          "200": {
            "description": "Public certificates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificates"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
