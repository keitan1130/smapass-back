{
  "openapi": "3.2.1",
  "info": {
    "title": "smapass-back API",
    "version": "0.1.0",
    "description": "IMEI-managed devices with anonymous app credentials, token rotation/revocation and device/certificate write authorization. Signed log ingestion, attestation, grading, certificate issuance and chain anchoring are not implemented."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Process liveness",
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "summary": "Database readiness",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
