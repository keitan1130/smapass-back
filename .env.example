# ローカル開発専用。URLに使える英数字の値にする。
POSTGRES_USER=smapass
POSTGRES_PASSWORD=smapass_local
POSTGRES_DB=smapass
API_PORT=8080
DB_PORT=5433
# コンテナ間では db:5432。ホストから Go を動かす場合は localhost:5433 に変更する。
DB_DSN=postgres://smapass:smapass_local@db:5432/smapass?sslmode=disable
CORS_ORIGINS=http://localhost:3000
# 未設定なら転送ヘッダーを信頼しない。cloudflared の直接接続元だけを CIDR で指定。
TRUSTED_PROXY_CIDRS=
# Android の applicationId と、APK 署名証明書の SHA-256（複数はカンマ区切り）。
# 未設定なら公開参照のみ利用でき、初回登録・鍵交換は503で拒否する。
ATTESTATION_PACKAGE_NAME=
ATTESTATION_SIGNING_SHA256=
# IMEI 自体のハードウェア attestation も要求する場合は true（対応権限・端末が必要）。
ATTESTATION_REQUIRE_IMEI=false
# Tapyrus アンカーワーカー（make anchor で起動。API サーバーには不要）。
# URL はダッシュボードのエンドポイント（https://xxx.api.tapyrus.chaintope.com、/api/v2 は付けない）。
# クライアント証明書は openssl pkcs12 -in <file>.p12 -out secrets/tapyrus-client.pem -nodes -clcerts で作る。
# secrets/tapyrus-client.pem は chmod 600。ワーカーはこの UID/GID で読む（id -u / id -g）。
HOST_UID=1000
HOST_GID=1000
TAPYRUS_API_URL=
TAPYRUS_ACCESS_TOKEN=
ANCHOR_CHAIN=tapyrus
ANCHOR_BATCH_INTERVAL=10m
ANCHOR_POLL_INTERVAL=30s
ANCHOR_MAX_LEAVES=1000

# compose.demo.yaml 用の汎用例。サーバーのLAN・VPN・Dockerと重ならないIPv4範囲を設定。
# DEMO_GATEWAYはこのsubnet内のアドレスを指定し、APIが信頼するホスト接続元にも使う。
DEMO_SUBNET=172.30.50.0/29
DEMO_GATEWAY=172.30.50.1
