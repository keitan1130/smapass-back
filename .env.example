# ローカル開発専用。URLに使える英数字の値にする。
POSTGRES_USER=smapass
POSTGRES_PASSWORD=smapass_local
POSTGRES_DB=smapass
API_PORT=8080
DB_PORT=5433
# コンテナ間では db:5432。ホストから Go を動かす場合は localhost:5433 に変更する。
DB_DSN=postgres://smapass:smapass_local@db:5432/smapass?sslmode=disable
CORS_ORIGINS=http://localhost:3000
# Android の applicationId と、APK 署名証明書の SHA-256（複数はカンマ区切り）。
# 未設定なら公開参照のみ利用でき、初回登録・鍵交換は503で拒否する。
ATTESTATION_PACKAGE_NAME=
ATTESTATION_SIGNING_SHA256=
# IMEI 自体のハードウェア attestation も要求する場合は true（対応権限・端末が必要）。
ATTESTATION_REQUIRE_IMEI=false
